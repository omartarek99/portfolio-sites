                      "ar": "البريد الإلكتروني"
                    },
                    "placeholder": {
                      "en": "you@example.com",
                      "ar": "you@example.com"
                    },
                    "required": true,
                    "half": true
                  },
                  {
                    "id": "role",
                    "type": "select",
                    "label": {
                      "en": "I am a…",
                      "ar": "أنا…"
                    },
                    "required": true,
                    "half": true,
                    "options": [
                      {
                        "value": "investor",
                        "label": {
                          "en": "Investor",
                          "ar": "مستثمر"
                        }
                      },
                      {
                        "value": "partner",
                        "label": {
                          "en": "Partner",
                          "ar": "شريك"
                        }
                      },
                      {
                        "value": "customer",
                        "label": {
                          "en": "Customer (center owner)",
                          "ar": "عميل (صاحب مركز)"
                        }
                      },
                      {
                        "value": "press",
                        "label": {
                          "en": "Press",
                          "ar": "صحافة"
                        }
                      }
                    ]
                  },
                  {
                    "id": "company",
                    "type": "text",
                    "label": {
                      "en": "Company or center",
                      "ar": "الشركة أو المركز"
                    },
                    "placeholder": {
                      "en": "Optional",
                      "ar": "اختياري"
                    },
                    "required": false,
                    "half": true
                  },
                  {
                    "id": "message",
                    "type": "textarea",
                    "label": {
                      "en": "Message",
                      "ar": "الرسالة"
                    },
                    "placeholder": {
                      "en": "What would you like to talk about?",
                      "ar": "عمّ تودّ أن نتحدث؟"
                    },
                    "required": true
                  }
                ],
