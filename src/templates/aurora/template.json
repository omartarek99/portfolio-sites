                    "ar": "الدور"
                  },
                  "value": {
                    "en": "Brand and packaging design",
                    "ar": "تصميم الهوية والتغليف"
                  }
                },
                {
                  "id": "year",
                  "label": {
                    "en": "Year",
                    "ar": "السنة"
                  },
                  "value": {
