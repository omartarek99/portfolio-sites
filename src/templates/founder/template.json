            "blockType": "contact",
            "variant": "form-details",
            "anchor": "contact",
            "example": true,
            "content": {
              "eyebrow": {
                "en": "05 · Contact",
                "ar": "05 · تواصل"
              },
              "heading": {
                "en": "Let’s talk",
                "ar": "لنتحدث"
              },
              "intro": {
                "en": "Investor, partner, center owner or journalist — tell us who you are and we will route you to the right person.",
                "ar": "مستثمرًا كنت أو شريكًا أو صاحب مركز أو صحفيًا، أخبرنا من أنت وسنوصلك بالشخص المناسب."
              },
              "form": {
                "name": "Pitch contact",
                "fields": [
                  {
                    "id": "name",
                    "type": "text",
                    "label": {
                      "en": "Name",
                      "ar": "الاسم"
                    },
                    "placeholder": {
                      "en": "Your name",
                      "ar": "اسمك"
                    },
                    "required": true,
                    "half": true
                  },
